# Cast CRM - variables de entorno
# Copia este archivo a `.env` y completa los valores.
# `.env` está en .gitignore; nunca subas secretos al repositorio.

# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL + Prisma)
# Requerida. Prisma la lee en prisma.config.ts y lib/prisma.ts.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cast_crm?schema=public"

# ---------------------------------------------------------------------------
# Better Auth (sesiones, email/password y OAuth)
# Requeridas.
#   BETTER_AUTH_SECRET: mínimo 32 caracteres. Genera con `openssl rand -base64 32`.
#   BETTER_AUTH_URL: URL base pública de la app (sin barra final).
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET="reemplaza-con-un-secreto-de-al-menos-32-caracteres"
BETTER_AUTH_URL="http://localhost:3000"

# Orígenes extra de confianza para CSRF (separados por coma). Opcional.
# BETTER_AUTH_TRUSTED_ORIGINS="https://app.tudominio.com,https://admin.tudominio.com"

# ---------------------------------------------------------------------------
# Proveedores sociales (usados por SocialButtons en sign-in / sign-up)
# Los botones siempre se muestran, así que configura ambos proveedores.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Email (SMTP con Nodemailer)
# En desarrollo, si SMTP_HOST está vacío se usa la bandeja de pruebas Ethereal
# y se imprime un enlace de previsualización por consola.
# En producción SMTP_HOST es obligatoria.
# EMAIL_SENDER es obligatoria para enviar (remitente de los correos).
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_SENDER="no-reply@cast-crm.com"

# ---------------------------------------------------------------------------
# Cloudinary (imágenes de productos y logos de organización)
# Opcional: si no se configuran, el módulo de imágenes devuelve
# IMAGES_NOT_CONFIGURED. CLOUDINARY_FOLDER por defecto es "cast-crm".
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="cast-crm"

# ---------------------------------------------------------------------------
# Modo de despliegue. Opcional (por defecto `multi`).
#   multi  -> SaaS: cualquiera puede crear organizaciones.
#   single -> una sola empresa: solo el primer usuario y los owners crean
#             organizaciones (sucursales); el resto entra por invitación.
# ---------------------------------------------------------------------------
DEPLOYMENT_MODE="multi"
